DATABASE_URL=
DATABASE_URL_DIRECT=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opcionais, para recuperação por e-mail
RESEND_API_KEY=
RESET_FROM=
# Configure apenas com um cabeçalho controlado pelo proxy confiável
AUTH_IP_HEADER=
# Piloto manual do OpenStreetMap, sujeito aos limites documentados
ENABLE_OSM_PILOT=false
# Extrato gerado localmente a partir da Geofabrik e da malha municipal do IBGE
ENABLE_OSM_SALVADOR_EXTRACT=false
# Geração de demonstrações (opcional, somente no servidor)
GEMINI_API_KEY=
GROQ_API_KEY=
# Mostra o orçamento na tela de geração após a contratação de um plano pago do Groq.
GROQ_PAID_PLAN=false
AI_PROVIDER=gemini
AI_DAILY_LIMIT=5
AI_MONTHLY_BUDGET_USD=5
